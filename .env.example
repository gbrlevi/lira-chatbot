# Chave da API do Gemini (o free tier é suficiente para rodar a PoC)
AI_API_KEY=

# Modelo de chat, no formato aceito por langchain.chat_models.init_chat_model
LLM_MODEL=gemini-3.5-flash-lite

# Tempo máximo, em segundos, de cada chamada ao modelo
LLM_TIMEOUT_SECONDS=30

# Provedor de embeddings: fastembed (local, sem chave) ou gemini
EMBEDDINGS_PROVIDER=fastembed

# Opcional: congela "agora" em testes e demonstrações (ISO 8601)
# REFERENCE_DATETIME=2026-03-25T10:00:00-04:00

# Opcional: rastreamento no LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
